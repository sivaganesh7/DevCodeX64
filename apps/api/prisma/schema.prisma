// DevCodeX64 — Prisma Schema
// Phase 1: Minimal schema to verify PostgreSQL + Prisma connection.
// Entities are added in the phase where they first become necessary.
// See docs/DATABASE.md for the full planned schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User — added here as it is required by Phase 2 (auth).
// Only defining it now so Phase 2 has a foundation to extend.
model User {
  id           String   @id @default(uuid()) @db.Uuid
  githubId     String?  @unique @map("github_id")
  username     String   @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash")
  name         String?
  avatarUrl    String?  @map("avatar_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
