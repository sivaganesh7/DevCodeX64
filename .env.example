# ─────────────────────────────────────────────────────────────────
# DevCodeX64 — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file.
# ─────────────────────────────────────────────────────────────────

# ── Phase 1: Required ─────────────────────────────────────────────

# NestJS API
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# PostgreSQL (match docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql://devcodex64:devcodex64_secret@localhost:5432/devcodex64

# ── Phase 2: Required when auth is implemented ────────────────────

# JWT (generate a long random secret — never use the placeholder)
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=15m

# GitHub OAuth App
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
GITHUB_WEBHOOK_SECRET=

# GitHub token encryption key (32-byte hex, generate with: openssl rand -hex 32)
GITHUB_TOKEN_ENCRYPTION_KEY=

# ── Phase 4+: Required when workers and AI are active ─────────────

# Redis
REDIS_URL=redis://localhost:6379

# AI Service (internal — not exposed to browser)
AI_SERVICE_URL=http://localhost:8000

# LLM Provider (choose one)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ── Frontend (Vite — these are public, non-secret) ────────────────

VITE_API_URL=http://localhost:3001
